PORT=5000
MONGO_URI=your_mongodb_connection_string

# Redis connection URL (e.g., redis://default:yourpassword@yourhost:yourport)
REDIS_URL=your_redis_connection_url

# JWT Secret Keys (Generate strong random keys, e.g., using `openssl rand -base64 32`)
ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret

# Cloudinary configuration keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_CLOUD_KEY=your_cloudinary_cloud_key
CLOUDINARY_CLOUD_SECRET=your_cloudinary_cloud_secret

# Stripe configuration keys
STRIPE_SECRET_KEY=your_stripe_secret_key

# Development URL and Environment
CLIENT_URL=http://localhost:5173
NODE_ENV=development
